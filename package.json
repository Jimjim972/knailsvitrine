{
  "name": "knails-vitrine",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test --experimental-strip-types tests/unit/auth/*.test.ts tests/unit/services/*.test.ts tests/unit/gallery/*.test.ts tests/unit/production-readiness/*.test.ts",
    "test:unit:contact": "node --test --experimental-strip-types tests/unit/contact/*.test.ts",
    "test:e2e:auth": "playwright test tests/admin-auth",
    "test:e2e:services": "playwright test tests/services-management",
    "test:e2e:services:scenarios": "node scripts/run-services-scenario-tests.mjs",
    "test:e2e:gallery": "playwright test tests/gallery-management",
    "test:e2e:contact": "playwright test tests/contact-form",
    "test:e2e:contact:scenarios": "node scripts/run-contact-scenario-tests.mjs",
    "test:e2e:gallery:scenarios": "node scripts/run-gallery-scenario-tests.mjs",
    "supabase:reset": "supabase db reset --local",
    "supabase:test:db": "supabase test db --local supabase/tests/database/01_schema_constraints.sql supabase/tests/database/02_public_access.sql supabase/tests/database/03_admin_table_access.sql supabase/tests/database/04_storage_policies.sql supabase/tests/database/05_foundation_inventory.sql supabase/tests/database/06_scale_and_order.sql supabase/tests/database/07_admin_authentication.sql supabase/tests/database/08_services_management.sql supabase/tests/database/09_gallery_management.sql supabase/tests/database/10_service_categories.sql",
    "supabase:test:auth": "node scripts/check-auth-signup.mjs",
    "supabase:test:storage": "node scripts/check-supabase-storage.mjs",
    "supabase:test:production-security": "supabase test db --local supabase/tests/database/04_storage_policies.sql supabase/tests/database/11_production_security.sql",
    "supabase:configure:gallery": "node scripts/configure-gallery-bucket.mjs --local",
    "gallery:bootstrap": "node scripts/bootstrap-gallery.mjs --local",
    "gallery:bootstrap:check": "node scripts/check-gallery-bootstrap.mjs",
    "supabase:lint": "supabase db lint --local --schema public,private --level warning --fail-on error",
    "supabase:advisors": "supabase db advisors --local --type all --level warn --fail-on error",
    "supabase:types:generate": "supabase gen types typescript --local --schema public > lib/supabase/database.types.ts",
    "supabase:types:check": "node scripts/check-types-drift.mjs",
    "foundation:check": "node scripts/run-foundation-checks.mjs",
    "auth:check": "node scripts/check-admin-auth.mjs",
    "services:check": "node scripts/check-services-management.mjs",
    "gallery:check": "node scripts/check-gallery-management.mjs",
    "contact:dev": "netlify dev --port 8888",
    "contact:check": "node scripts/check-contact-form.mjs",
    "production:target-check": "node --experimental-strip-types scripts/check-deploy-target.mjs",
    "security:hosted-check": "node scripts/check-hosted-supabase-security.mjs",
    "security:preview-check": "node --experimental-strip-types scripts/check-preview-security.mjs",
    "security:check": "node scripts/check-production-security.mjs",
    "seo:check": "node scripts/check-seo.mjs",
    "test:e2e:seo": "KN_PLAYWRIGHT_SUITE=seo KN_PLAYWRIGHT_EXTERNAL_SERVER=true playwright test tests/production-readiness/seo.spec.ts",
    "test:e2e:accessibility": "KN_PLAYWRIGHT_SUITE=accessibility playwright test tests/production-readiness/accessibility-public.spec.ts tests/production-readiness/accessibility-admin.spec.ts",
    "test:e2e:production-readiness": "KN_PLAYWRIGHT_SUITE=production-readiness KN_PLAYWRIGHT_EXTERNAL_SERVER=true playwright test tests/production-readiness/deployment.spec.ts tests/production-readiness/security-headers.spec.ts tests/production-readiness/seo.spec.ts tests/production-readiness/accessibility-public.spec.ts tests/production-readiness/accessibility-admin.spec.ts",
    "production:smoke": "node scripts/smoke-production.mjs",
    "production:check": "node --experimental-strip-types scripts/check-production-readiness.mjs --profile local",
    "production:preview-check": "node --experimental-strip-types scripts/check-production-readiness.mjs --profile preview",
    "recovery:check": "node scripts/check-recovery-readiness.mjs",
    "documentation:check": "node --experimental-strip-types scripts/check-documentation-sync.mjs",
    "scan:build-secrets": "node scripts/scan-build-secrets.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@netlify/edge-functions": "4.0.0",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.0",
    "netlify-cli": "27.1.2",
    "sharp": "0.35.3",
    "supabase": "2.112.0",
    "typescript": "^5.8.0"
  }
}
