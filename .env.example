# Trois variables runtime applicatives obligatoires, distinctes par contexte Netlify.
# URL HTTPS distante ou URL HTTP loopback exacte pour Supabase local.
NEXT_PUBLIC_SUPABASE_URL=
# Clé publiable du même projet Supabase. Ne jamais utiliser service_role/sb_secret_.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret serveur aléatoire d'au moins 32 caractères, sans préfixe NEXT_PUBLIC_.
SERVICE_SUCCESS_FLASH_SECRET=

# CONTEXT, URL, DEPLOY_PRIME_URL et COMMIT_REF sont réservées à Netlify et ne sont
# pas définies dans ce fichier. Les variables SUPABASE_GALLERY_CONFIG_* sont
# interdites au runtime et dans Netlify.

# Réservé au runner E2E local. Laisser vide dans tout autre contexte.
KN_SERVICE_E2E_SCENARIO=

PLAYWRIGHT_BASE_URL=
